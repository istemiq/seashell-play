{
  "appId": "ru.sishel.seashell",
  "appName": "Seashell",
  "webDir": "build",
  "android": {
    "allowMixedContent": true
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "GoogleAuth": {
      "scopes": ["profile", "email"],
      "serverClientId": "",
      "forceCodeForRefreshToken": false
    }
  }
}
