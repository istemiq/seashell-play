{
  "name": "seashell-play",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/ensure-db.mjs && concurrently -k -n api,web -c blue,magenta \"npm:api\" \"npm:start\"",
    "dev:web": "vite",
    "start": "vite",
    "api": "node server/index.js",
    "db": "docker compose up -d db",
    "db:down": "docker compose down",
    "build": "vite build",
    "build:android": "vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:sync": "npx cap sync android",
    "android:run": "npm run build:android && npx cap run android",
    "test": "node --test server/tests/*.test.js",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@codetrix-studio/capacitor-google-auth": "3.4.0-rc.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "vite": "^5.0.8"
  }
}
