# Seashell Google Play — frontend (Vite)
# Copy to .env for local dev / emulator

# Emulator → API on your PC (Android Studio AVD)
VITE_API_URL=http://10.0.2.2:3001

# Dev sign-in without Google Cloud (emulator only)
VITE_PLAY_DEV_AUTH=1
VITE_PLAY_DEV_USER_ID=5000000001

# Real Google Sign-In (production / device testing)
# Web OAuth client id from Google Cloud Console
# VITE_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# VITE_PLAY_DEV_AUTH=0
